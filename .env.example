# ============================================================
# SpeechLLM — laptop development environment
# ============================================================
# Copy to .env and fill in:
#   cp .env.example .env
#
# NOTE: none of this is needed by the Orange Pi device. It runs fully offline
# with no API key. Device configuration lives in deploy/orangepi/device.env.
# ============================================================

# [OPTIONAL] Gemini API key — used only by the dev server and by
# tools/expand_bank.py when drafting new phrase variants.
# Get a free key: https://aistudio.google.com/app/apikey
# NEVER commit a real key. This file is checked into git.
GOOGLE_API_KEY=

# [OPTIONAL] Google Cloud TTS for rendering the phrase bank with better
# id-ID voices. Point at a service-account JSON; billing must be enabled.
#   python tools/render_bank.py --voice google-cloud
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# [OPTIONAL] Gemini tuning (dev server only)
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=2000
GEMINI_TEMPERATURE=0.7

# [OPTIONAL] Percentage of dev-server responses generated by Gemini rather than
# templates. The device forces this to 0 — it can only speak pre-rendered audio.
GEMINI_USAGE_PERCENT=30
