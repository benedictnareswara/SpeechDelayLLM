# ============================================================
# SpeechLLM Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get your free Gemini API key at:
#   https://aistudio.google.com/app/apikey
# ============================================================

# [REQUIRED] Google Gemini API Key
GOOGLE_API_KEY=***REMOVED-ROTATE-THIS-KEY***

# [OPTIONAL] Vosk model path (defaults to models/vosk-model-small-id)
VOSK_MODEL_PATH=models/vosk-model-small-id

# [OPTIONAL] Audio settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# [OPTIONAL] Gemini settings
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=2000
GEMINI_TEMPERATURE=0.7

# [OPTIONAL] Router settings — percentage of responses using Gemini (0-100)
GEMINI_USAGE_PERCENT=30
