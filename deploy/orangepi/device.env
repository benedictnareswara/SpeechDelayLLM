# SpeechLLM device configuration — Orange Pi Zero 3
#
# Loaded by systemd (EnvironmentFile in speechllm.service). Values here override
# the defaults in packages/speechllm-core/src/speechllm_core/settings.py.
#
# Copy to /etc/speechllm/device.env and edit for your unit.

# ── Install location ─────────────────────────────────────────
SPEECHLLM_ROOT=/opt/speechllm

# ── Offline operation ────────────────────────────────────────
# Pre-staged Whisper weights. Without HF_HUB_OFFLINE the first transcription
# blocks on a HuggingFace request that cannot succeed.
#
# HF_HOME must match the value install.sh stages with. Staged anywhere else,
# the service cannot read it — it runs as a different user, and ProtectHome=true
# hides /root — and you find out at the first transcription, not at install.
HF_HOME=/opt/speechllm/models/hf
HF_HUB_OFFLINE=1

# ── Microphone ───────────────────────────────────────────────
# Substring of the device name from `python -m speechllm_device --list-devices`.
# A name is used rather than an index because card order changes across boots.
#
# "USB" matches the generic descriptor most cheap capsules report, but plenty
# do not — a GVAUDIO capsule, for instance, needs AUDIO_INPUT_DEVICE=GVAUDIO.
# Get this wrong and ALSA falls through to the system default, which on this
# board is HDMI: no capture channel, and a confusing stream error rather than
# an obvious "wrong device" one. Always confirm with --list-devices.
#
# A bare number (AUDIO_INPUT_DEVICE=3) forces that device index instead. Handy
# during bring-up, but indexes move between boots — go back to a name for
# anything long-running.
AUDIO_INPUT_DEVICE=USB
# Most USB capsules will not open at 16 kHz. Capture at their native rate and
# let capture.py resample. Set to 0 if your mic genuinely supports 16 kHz.
AUDIO_CAPTURE_RATE=48000

# ── Endpointing ──────────────────────────────────────────────
# Lower silence_ms feels snappier for toddlers, who pause a lot mid-babble.
# Raise it if the device keeps interrupting them.
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=150
VAD_MAX_SPEECH_MS=3000
VAD_SILENCE_MS=400

# ── Speech recognition ───────────────────────────────────────
STT_MODEL_SIZE=tiny
STT_COMPUTE_TYPE=int8
STT_THREADS=4
STT_LANGUAGE=id

# ── DFPlayer ─────────────────────────────────────────────────
# UART5 on 26-pin header pins 8 (TX) and 10 (RX), enabled by the `ph-uart5`
# device-tree overlay on the official Orange Pi image (Armbian calls the same
# thing `uart5-ph`). See SETUP.md Phase 3 — and set this to whatever
# `ls /dev/ttyS*` actually reports after the reboot, which is not guaranteed
# to be ttyS5.
#
# If the overlay will not cooperate, a USB-to-TTL adapter needs no device-tree
# work at all: plug it in, set DFPLAYER_PORT=/dev/ttyUSB0, move the three
# DFPlayer wires onto it. The DFPlayer only wants 9600 8N1 from *some* UART.
AUDIO_SINK=dfplayer
DFPLAYER_PORT=/dev/ttyS5
DFPLAYER_VOLUME=22
# BUSY on PI0 = physical pin 11. Allwinner BSP numbering: bank*32 + pin, I=8.
DFPLAYER_BUSY_GPIO=256
DFPLAYER_GPIOCHIP=gpiochip0

# ── Pipeline ─────────────────────────────────────────────────
SPEAK_COOLDOWN_MS=300
PLAYBACK_TIMEOUT_S=15
BANK_MANIFEST=/opt/speechllm/assets/bank/manifest.json
VAD_MODEL_PATH=/opt/speechllm/models/silero_vad.onnx
INTERACTION_LOG=/var/log/speechllm/interactions.jsonl
